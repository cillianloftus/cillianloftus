{
  "name": "cillianloftus",
  "compatibility_date": "2026-09-07",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every other path is still served straight from static assets with no
    // Worker involved at all — this only routes /private/* through the
    // password-gate Worker first (see worker/index.ts).
    "run_worker_first": ["/private/*"]
  }
}