---
import Icon from './icons/Icon.astro';
---

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Drawing viewer" tabindex="-1" inert>
	<div class="lightbox-backdrop"></div>

	<button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Close">
		<Icon name="close" size={22} />
	</button>

	<button type="button" class="lightbox-btn lightbox-nav lightbox-prev" aria-label="Previous drawing">
		<Icon name="chevron-left" size={26} />
	</button>

	<button type="button" class="lightbox-btn lightbox-nav lightbox-next" aria-label="Next drawing">
		<Icon name="chevron-right" size={26} />
	</button>

	<div class="lightbox-stage" data-lightbox-close>
		<div class="lightbox-frame"><img class="lightbox-image" alt="" /></div>
		<div class="lightbox-frame"><img class="lightbox-image" alt="" /></div>
	</div>

	<div class="lightbox-footer">
		<p class="lightbox-caption" data-lightbox-caption></p>
		<p class="lightbox-count" data-lightbox-count></p>
	</div>
</div>

<script>
	const SWIPE_THRESHOLD = 60;
	const DISMISS_THRESHOLD = 80;
	const DESKTOP_ZOOM_SCALE = 2.2;
	const SLIDE_DURATION = 320;
	const REDUCED_SLIDE_DURATION = 1;
	const SLIDE_EASING = 'cubic-bezier(0.22, 0.61, 0.36, 1)';

	// The slide runs through the Web Animations API, not a CSS
	// transition/animation, so the site's global `prefers-reduced-motion`
	// rule (global.css, which only zeroes `animation-duration` and
	// `transition-duration`) never touches it — checked here instead, and
	// live via the query's own change event rather than read once, so
	// toggling the OS setting while the lightbox is open takes effect
	// immediately. Live touch-drag tracking is untouched either way: it's
	// direct 1:1 finger tracking with no animation to begin with, and
	// user-initiated drag isn't the kind of motion this preference targets.
	const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
	let reduceMotion = reduceMotionQuery.matches;
	reduceMotionQuery.addEventListener('change', (e) => {
		reduceMotion = e.matches;
	});

	function initLightbox() {
		const lightbox = document.getElementById('lightbox');
		if (!lightbox) return;

		// Move to a direct child of <body>. Nested where Astro places it by
		// default, ancestor CSS (the sticky header's backdrop-filter, in
		// particular) can bleed through this overlay in a Chromium compositing
		// quirk despite correct z-index and hit-testing — moving it out from
		// under any such ancestor sidesteps the whole class of bug.
		if (lightbox.parentElement !== document.body) {
			document.body.appendChild(lightbox);
		}

		const stageEl = lightbox.querySelector<HTMLElement>('.lightbox-stage');
		const frameEls = Array.from(lightbox.querySelectorAll<HTMLElement>('.lightbox-frame'));
		const captionElEl = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]');
		const countElEl = lightbox.querySelector<HTMLElement>('[data-lightbox-count]');
		const prevBtnEl = lightbox.querySelector<HTMLButtonElement>('.lightbox-prev');
		const nextBtnEl = lightbox.querySelector<HTMLButtonElement>('.lightbox-next');
		const closeTargets = lightbox.querySelectorAll<HTMLElement>('[data-lightbox-close]');
		if (frameEls.length !== 2 || !stageEl || !captionElEl || !countElEl || !prevBtnEl || !nextBtnEl) {
			return;
		}

		// Rebind to fresh consts so TS carries the non-null narrowing above into
		// the closures below (it doesn't do this for the original bindings).
		const lightboxEl = lightbox;
		const stage = stageEl;
		const captionEl = captionElEl;
		const countEl = countElEl;
		const prevBtn = prevBtnEl;
		const nextBtn = nextBtnEl;

		// Two frames, not one. The whole point of this rewrite is that a
		// navigation is a single motion where the outgoing and incoming
		// drawings move together — the old one sliding out and the new one
		// sliding in have to be visible and animating at the same time, which
		// is impossible with a single frame that's re-sourced mid-transition.
		// "active" is whichever frame is showing the current drawing at rest;
		// the other one is idle (hidden) except while a navigation — a
		// button/key press, or a live touch drag — is in progress, when it
		// carries the adjacent drawing in from the opposite edge.
		type FrameRef = { el: HTMLElement; img: HTMLImageElement };
		const frames: FrameRef[] = frameEls.map((el) => ({
			el,
			img: el.querySelector('img') as HTMLImageElement,
		}));
		let activeIndex = 0;

		let currentIndex = -1;
		let opener: HTMLElement | null = null;
		let isAnimating = false;
		let drag: { startX: number; startY: number; dx: number; dy: number; axis: 'x' | 'y' | null } | null = null;
		// Locked in as soon as a horizontal drag's direction is known (not
		// necessarily equal to the final swipe direction — it can flip if the
		// user reverses mid-drag), so the drag handlers and the release/commit
		// logic agree on which neighbor is currently loaded into the idle frame.
		let dragDirection: 1 | -1 | null = null;
		const preloaded = new Set<string>();

		function wrap(n: number, len: number) {
			return ((n % len) + len) % len;
		}

		// Desktop (mouse) zoom. Native pinch-zoom only exists for touch, so a
		// mouse user has no way to zoom at all without this — click toggles a
		// fixed zoom level, drag pans while zoomed.
		let desktopZoomed = false;
		let panX = 0;
		let panY = 0;
		let isMouseDown = false;
		let isPanningMouse = false;
		let mouseDownPos = { x: 0, y: 0 };
		let mouseMoveDistance = 0;
		let panPointerStart = { x: 0, y: 0 };
		let panOriginStart = { x: 0, y: 0 };

		function getVisibleTriggers(): HTMLElement[] {
			return Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox]')).filter((el) => {
				const item = el.closest('.drawing-item');
				return !item || !item.classList.contains('is-hidden');
			});
		}

		function resetZoom() {
			const meta = document.querySelector('meta[name="viewport"]');
			if (meta) {
				const original = meta.getAttribute('content') || '';
				meta.setAttribute('content', `${original}, maximum-scale=1`);
				requestAnimationFrame(() => meta.setAttribute('content', original));
			}
			setDesktopZoom(false);
		}

		function applyDesktopZoomTransform() {
			const img = frames[activeIndex].img;
			img.style.transform = desktopZoomed ? `translate(${panX}px, ${panY}px) scale(${DESKTOP_ZOOM_SCALE})` : '';
		}

		function clampPan() {
			const frameRect = frames[activeIndex].el.getBoundingClientRect();
			const maxX = (frameRect.width * (DESKTOP_ZOOM_SCALE - 1)) / 2;
			const maxY = (frameRect.height * (DESKTOP_ZOOM_SCALE - 1)) / 2;
			panX = Math.min(maxX, Math.max(-maxX, panX));
			panY = Math.min(maxY, Math.max(-maxY, panY));
		}

		function setDesktopZoom(value: boolean) {
			desktopZoomed = value;
			panX = 0;
			panY = 0;
			frames[activeIndex].img.classList.toggle('is-zoomed', desktopZoomed);
			applyDesktopZoomTransform();
		}

		// The stage's available space, cached rather than read fresh in
		// sizeFrame every time a navigation starts. sizeFrame runs right
		// after a style write (the idle frame's visibility flipping on), so
		// reading layout-dependent properties there would force a
		// synchronous reflow at exactly the moment a slide needs to start
		// smoothly — this way that read only happens on open and on resize,
		// when a one-time layout cost doesn't read as a stutter.
		let stageAvailW = 0;
		let stageAvailH = 0;

		function measureStage() {
			const stageStyle = getComputedStyle(stage);
			stageAvailW = stage.clientWidth - parseFloat(stageStyle.paddingLeft) - parseFloat(stageStyle.paddingRight);
			stageAvailH = stage.clientHeight - parseFloat(stageStyle.paddingTop) - parseFloat(stageStyle.paddingBottom);
		}

		// A frame's pixel size is computed directly here, from the trigger's
		// known aspect ratio and the stage's cached available space — rather
		// than relying on CSS aspect-ratio, which doesn't resolve predictably
		// once a real image with its own intrinsic size loads into it. This
		// runs before any pixel of either the thumbnail or full-res image has
		// loaded, so the box is already the right size and never resizes once
		// a higher-res image swaps in.
		function sizeFrame(el: HTMLElement, ratio: number) {
			if (!Number.isFinite(ratio) || ratio <= 0) return;
			let w = stageAvailW;
			let h = w / ratio;
			if (h > stageAvailH) {
				h = stageAvailH;
				w = h * ratio;
			}
			el.style.width = `${Math.max(w, 0)}px`;
			el.style.height = `${Math.max(h, 0)}px`;
		}

		// Warms the full-res asset for whichever drawing prev/next would land
		// on, so stepping there a moment later doesn't wait on the network.
		function preloadNeighbors(triggers: HTMLElement[]) {
			const len = triggers.length;
			if (len < 2) return;
			[currentIndex - 1, currentIndex + 1].forEach((i) => {
				const trigger = triggers[((i % len) + len) % len];
				const fullSrc = trigger?.dataset.fullSrc;
				if (fullSrc && !preloaded.has(fullSrc)) {
					preloaded.add(fullSrc);
					new Image().src = fullSrc;
				}
			});
		}

		// Loads a trigger's content into a given frame — sizing plus image
		// src, nothing about caption/count, since those only ever describe
		// whichever trigger is currentIndex, not whatever's momentarily
		// loaded into the idle frame mid-drag.
		function loadInto(frame: FrameRef, trigger: HTMLElement) {
			sizeFrame(frame.el, parseFloat(trigger.dataset.aspectRatio || ''));

			const thumb = trigger.querySelector('img');
			frame.img.src = thumb?.currentSrc || thumb?.src || trigger.dataset.fullSrc || '';
			frame.img.alt = trigger.dataset.alt || trigger.dataset.caption || '';

			const fullSrc = trigger.dataset.fullSrc;
			if (fullSrc) {
				preloaded.add(fullSrc);
				const preload = new Image();
				preload.onload = () => {
					frame.img.src = fullSrc;
				};
				preload.src = fullSrc;
			}
		}

		function updateMeta(triggers: HTMLElement[]) {
			const trigger = triggers[currentIndex];
			if (!trigger) return;
			captionEl.textContent = trigger.dataset.caption || '';
			const multiple = triggers.length > 1;
			countEl.textContent = multiple ? `${currentIndex + 1} / ${triggers.length}` : '';
			prevBtn.hidden = !multiple;
			nextBtn.hidden = !multiple;
		}

		function resizeFrame() {
			measureStage();
			const triggers = getVisibleTriggers();
			const trigger = triggers[currentIndex];
			if (trigger) sizeFrame(frames[activeIndex].el, parseFloat(trigger.dataset.aspectRatio || ''));
		}

		window.addEventListener('resize', resizeFrame);

		function open(index: number, openedFrom: HTMLElement) {
			const triggers = getVisibleTriggers();
			if (!triggers.length) return;
			currentIndex = wrap(index, triggers.length);
			opener = openedFrom;
			activeIndex = 0;
			// Re-measured on every open, not just once at page load: opening
			// the lightbox sets body overflow to hidden, which can change the
			// scrollbar's presence and shift the viewport's available width.
			measureStage();
			frames[0].el.style.visibility = 'visible';
			frames[1].el.style.visibility = 'hidden';
			setFrameX(frames[0].el, 0);
			setFrameX(frames[1].el, 0);
			loadInto(frames[0], triggers[currentIndex]);
			updateMeta(triggers);
			preloadNeighbors(triggers);
			lightboxEl.removeAttribute('inert');
			lightboxEl.classList.add('is-open');
			document.body.style.overflow = 'hidden';
			lightboxEl.focus();
			document.addEventListener('keydown', onKeydown);
		}

		function close() {
			lightboxEl.classList.remove('is-open');
			lightboxEl.setAttribute('inert', '');
			document.body.style.overflow = '';
			document.removeEventListener('keydown', onKeydown);
			resetZoom();
			stage.classList.remove('is-dragging');
			stage.style.transform = '';
			stage.style.opacity = '';
			drag = null;
			dragDirection = null;
			frames[1 - activeIndex].el.style.visibility = 'hidden';
			opener?.focus();
		}

		// The full stage width, not either frame's own (often narrower) width,
		// so a slide is always genuinely clear of the stage regardless of the
		// drawing's aspect ratio.
		function slideDistance() {
			return stage.clientWidth;
		}

		function setFrameX(el: HTMLElement, px: number) {
			el.style.transform = `translate(-50%, -50%) translateX(${px}px)`;
		}

		// Runs a leg of the slide as an explicit Web Animations API keyframe
		// animation rather than a CSS transition. A CSS transition animates
		// from whatever the element's rendered state happens to be, which
		// matters once two frames are animating together from a live-drag
		// position: a WAAPI animation's keyframes are explicit values, so
		// there's nothing timing-dependent for the browser to elide between
		// the drag's last direct style write and the animation's first frame.
		function animateFrameX(el: HTMLElement, fromPx: number, toPx: number): Promise<void> {
			return new Promise((resolve) => {
				const anim = el.animate(
					[
						{ transform: `translate(-50%, -50%) translateX(${fromPx}px)` },
						{ transform: `translate(-50%, -50%) translateX(${toPx}px)` },
					],
					{ duration: reduceMotion ? REDUCED_SLIDE_DURATION : SLIDE_DURATION, easing: SLIDE_EASING, fill: 'forwards' },
				);
				anim.finished
					.then(() => {
						anim.cancel();
						setFrameX(el, toPx);
						resolve();
					})
					.catch(() => resolve());
			});
		}

		// The outgoing and incoming drawings slide as one motion: both frames
		// animate at once, the active one leaving in `direction` while the
		// idle one arrives from the opposite edge — not two animations run
		// back to back. `startDx` lets this continue smoothly from wherever a
		// live drag left off rather than always starting at rest; when the
		// drag already loaded and positioned the idle frame (`alreadyPrepared`),
		// this only has to animate it home instead of re-doing that setup.
		function slideTo(direction: 1 | -1, startDx = 0, alreadyPrepared = false): Promise<void> {
			const triggers = getVisibleTriggers();
			if (triggers.length <= 1) return Promise.resolve();
			isAnimating = true;
			resetZoom();

			const nextIndex = wrap(currentIndex + direction, triggers.length);
			const active = frames[activeIndex];
			const incoming = frames[1 - activeIndex];

			if (!alreadyPrepared) {
				incoming.el.style.visibility = 'visible';
				loadInto(incoming, triggers[nextIndex]);
				setFrameX(incoming.el, direction * slideDistance() + startDx);
			}

			return Promise.all([
				animateFrameX(active.el, startDx, -direction * slideDistance()),
				animateFrameX(incoming.el, direction * slideDistance() + startDx, 0),
			]).then(() => {
				active.el.style.visibility = 'hidden';
				currentIndex = nextIndex;
				activeIndex = 1 - activeIndex;
				updateMeta(triggers);
				preloadNeighbors(triggers);
				isAnimating = false;
			});
		}

		// Below the swipe threshold: both frames return to rest together
		// rather than just the active one, since the idle frame was already
		// visibly following the drag.
		function springBack(direction: 1 | -1, startDx: number): Promise<void> {
			isAnimating = true;
			const active = frames[activeIndex];
			const incoming = frames[1 - activeIndex];
			return Promise.all([
				animateFrameX(active.el, startDx, 0),
				animateFrameX(incoming.el, startDx + direction * slideDistance(), direction * slideDistance()),
			]).then(() => {
				incoming.el.style.visibility = 'hidden';
				isAnimating = false;
			});
		}

		function goTo(direction: 1 | -1) {
			if (isAnimating) return;
			slideTo(direction);
		}

		function onKeydown(e: KeyboardEvent) {
			if (e.key === 'Escape') {
				close();
			} else if (e.key === 'ArrowLeft') {
				goTo(-1);
			} else if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Spacebar') {
				e.preventDefault();
				goTo(1);
			} else if (e.key === 'Tab') {
				// Minimal focus trap across the three controls that are ever focusable.
				const focusable = [prevBtn, nextBtn, ...closeTargets].filter(
					(el) => !el.hidden && el.tabIndex !== -1,
				);
				if (!focusable.length) return;
				const first = focusable[0];
				const last = focusable[focusable.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		}

		document.addEventListener('click', (e) => {
			const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
			if (!trigger) return;
			const triggers = getVisibleTriggers();
			const index = triggers.indexOf(trigger);
			if (index !== -1) open(index, trigger);
		});

		closeTargets.forEach((el) =>
			el.addEventListener('click', (e) => {
				// Closes for a click on the empty stage area or the close button
				// itself (including its icon) — not one that bubbled up from the
				// image, which sits inside the stage but shouldn't dismiss it.
				const target = e.target as HTMLElement;
				if (!target.closest('.lightbox-image')) close();
			}),
		);
		prevBtn.addEventListener('click', () => goTo(-1));
		nextBtn.addEventListener('click', () => goTo(1));

		// Desktop zoom: click toggles a fixed zoom level, drag pans while
		// zoomed. Both frames' images are wired up the same way (each
		// element identity persists across navigations — only its src
		// changes — so this only needs to run once each), guarded so only
		// the currently-active one actually responds.
		function attachZoomHandlers(frame: FrameRef) {
			frame.img.addEventListener('mousedown', (e) => {
				if (frames[activeIndex] !== frame || e.button !== 0 || isAnimating) return;
				isMouseDown = true;
				mouseDownPos = { x: e.clientX, y: e.clientY };
				mouseMoveDistance = 0;
				if (desktopZoomed) {
					isPanningMouse = true;
					panPointerStart = { x: e.clientX, y: e.clientY };
					panOriginStart = { x: panX, y: panY };
					e.preventDefault();
				}
			});

			frame.img.addEventListener('click', () => {
				// A real drag-to-pan shouldn't also toggle zoom off on release.
				if (frames[activeIndex] !== frame || isAnimating || mouseMoveDistance > 4) return;
				setDesktopZoom(!desktopZoomed);
			});
		}
		frames.forEach(attachZoomHandlers);

		window.addEventListener('mousemove', (e) => {
			if (!isMouseDown) return;
			mouseMoveDistance = Math.max(
				mouseMoveDistance,
				Math.hypot(e.clientX - mouseDownPos.x, e.clientY - mouseDownPos.y),
			);
			if (!isPanningMouse) return;
			panX = panOriginStart.x + (e.clientX - panPointerStart.x);
			panY = panOriginStart.y + (e.clientY - panPointerStart.y);
			clampPan();
			applyDesktopZoomTransform();
		});

		window.addEventListener('mouseup', () => {
			isMouseDown = false;
			isPanningMouse = false;
		});

		// Single-finger swipe navigates/dismisses; two fingers (or an active
		// pinch-zoom) are left alone so the browser's native zoom takes over.
		stage.addEventListener(
			'touchstart',
			(e) => {
				if (isAnimating || e.touches.length !== 1 || (window.visualViewport && window.visualViewport.scale > 1.02)) {
					drag = null;
					return;
				}
				const t = e.touches[0];
				drag = { startX: t.clientX, startY: t.clientY, dx: 0, dy: 0, axis: null };
				dragDirection = null;
			},
			{ passive: true },
		);

		stage.addEventListener(
			'touchmove',
			(e) => {
				if (!drag || e.touches.length !== 1) return;
				const t = e.touches[0];
				drag.dx = t.clientX - drag.startX;
				drag.dy = t.clientY - drag.startY;
				if (!drag.axis && (Math.abs(drag.dx) > 8 || Math.abs(drag.dy) > 8)) {
					drag.axis = Math.abs(drag.dx) > Math.abs(drag.dy) ? 'x' : 'y';
					if (drag.axis === 'y') stage.classList.add('is-dragging');
				}
				if (drag.axis === 'x') {
					setFrameX(frames[activeIndex].el, drag.dx);

					// The idle frame carries the adjacent drawing in from the
					// opposite edge in lockstep with the drag, so the two
					// read as one connected motion rather than the active
					// image just sliding off into nothing. Which neighbor
					// that is follows the live drag direction, and swaps if
					// the user reverses mid-drag.
					const dir: 1 | -1 | null = drag.dx < 0 ? 1 : drag.dx > 0 ? -1 : dragDirection;
					if (dir && dir !== dragDirection) {
						// Only walk the page's [data-lightbox] elements when the
						// direction actually changes, not on every touchmove —
						// this list can be large (every drawing on /drawings),
						// and re-querying it on every pixel of finger movement
						// was a real source of stutter during a drag.
						const triggers = getVisibleTriggers();
						if (triggers.length > 1) {
							dragDirection = dir;
							const nextIndex = wrap(currentIndex + dir, triggers.length);
							const incoming = frames[1 - activeIndex];
							incoming.el.style.visibility = 'visible';
							loadInto(incoming, triggers[nextIndex]);
						}
					}
					if (dragDirection) {
						setFrameX(frames[1 - activeIndex].el, drag.dx + dragDirection * slideDistance());
					}
				} else if (drag.axis === 'y' && drag.dy > 0) {
					stage.style.transform = `translateY(${drag.dy}px)`;
					stage.style.opacity = String(Math.max(1 - drag.dy / 400, 0.3));
				}
			},
			{ passive: true },
		);

		stage.addEventListener('touchend', () => {
			if (!drag) return;
			const { dx, dy, axis } = drag;
			const direction = dragDirection;
			drag = null;

			if (axis === 'x') {
				if (direction && Math.abs(dx) > SWIPE_THRESHOLD) {
					slideTo(direction, dx, true).then(() => {
						dragDirection = null;
					});
				} else if (direction) {
					// Didn't clear the threshold — both frames spring back to
					// rest rather than committing to a navigation.
					springBack(direction, dx).then(() => {
						dragDirection = null;
					});
				} else {
					// Never resolved a direction (negligible horizontal
					// movement) — just the active frame to settle.
					isAnimating = true;
					animateFrameX(frames[activeIndex].el, dx, 0).then(() => {
						isAnimating = false;
					});
				}
			} else if (axis === 'y') {
				stage.classList.remove('is-dragging');
				if (dy > DISMISS_THRESHOLD) {
					close();
				} else {
					stage.style.transform = '';
					stage.style.opacity = '';
				}
			}
		});
	}

	document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.25s ease;
	}

	.lightbox.is-open {
		opacity: 1;
		visibility: visible;
	}

	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: black;
		opacity: 0.75;
	}

	.lightbox-btn {
		position: absolute;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: none;
		border: none;
		padding: 0;
		color: rgba(255, 255, 255, 0.85);
		cursor: pointer;
		transition: color 0.15s ease;
	}

	.lightbox-btn:hover,
	.lightbox-btn:focus-visible {
		color: white;
	}

