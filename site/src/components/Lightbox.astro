---
import Icon from './icons/Icon.astro';
---

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Drawing viewer" tabindex="-1" inert>
	<div class="lightbox-backdrop"></div>

	<button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Close">
		<Icon name="close" size={22} />
	</button>

	<button type="button" class="lightbox-btn lightbox-nav lightbox-prev" aria-label="Previous drawing">
		<Icon name="chevron-left" size={26} />
	</button>

	<button type="button" class="lightbox-btn lightbox-nav lightbox-next" aria-label="Next drawing">
		<Icon name="chevron-right" size={26} />
	</button>

	<div class="lightbox-stage" data-lightbox-close>
		<div class="lightbox-frame"><img class="lightbox-image" alt="" /></div>
	</div>

	<div class="lightbox-footer">
		<p class="lightbox-caption" data-lightbox-caption></p>
		<p class="lightbox-count" data-lightbox-count></p>
	</div>
</div>

<script>
	const SWIPE_THRESHOLD = 60;
	const DISMISS_THRESHOLD = 80;
	const DESKTOP_ZOOM_SCALE = 2.2;

	function initLightbox() {
		const lightbox = document.getElementById('lightbox');
		if (!lightbox) return;

		// Move to a direct child of <body>. Nested where Astro places it by
		// default, ancestor CSS (the sticky header's backdrop-filter, in
		// particular) can bleed through this overlay in a Chromium compositing
		// quirk despite correct z-index and hit-testing — moving it out from
		// under any such ancestor sidesteps the whole class of bug.
		if (lightbox.parentElement !== document.body) {
			document.body.appendChild(lightbox);
		}

		const stageEl = lightbox.querySelector<HTMLElement>('.lightbox-stage');
		const frameEl = lightbox.querySelector<HTMLElement>('.lightbox-frame');
		const imgEl = lightbox.querySelector<HTMLImageElement>('.lightbox-image');
		const captionElEl = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]');
		const countElEl = lightbox.querySelector<HTMLElement>('[data-lightbox-count]');
		const prevBtnEl = lightbox.querySelector<HTMLButtonElement>('.lightbox-prev');
		const nextBtnEl = lightbox.querySelector<HTMLButtonElement>('.lightbox-next');
		const closeTargets = lightbox.querySelectorAll<HTMLElement>('[data-lightbox-close]');
		if (!stageEl || !frameEl || !imgEl || !captionElEl || !countElEl || !prevBtnEl || !nextBtnEl) {
			return;
		}

		// Rebind to fresh consts so TS carries the non-null narrowing above into
		// the closures below (it doesn't do this for the original bindings).
		const lightboxEl = lightbox;
		const stage = stageEl;
		const frame = frameEl;
		const img = imgEl;
		const captionEl = captionElEl;
		const countEl = countElEl;
		const prevBtn = prevBtnEl;
		const nextBtn = nextBtnEl;

		let currentIndex = -1;
		let opener: HTMLElement | null = null;
		let isAnimating = false;
		let drag: { startX: number; startY: number; dx: number; dy: number; axis: 'x' | 'y' | null } | null = null;
		const preloaded = new Set<string>();

		// Desktop (mouse) zoom. Native pinch-zoom only exists for touch, so a
		// mouse user has no way to zoom at all without this — click toggles a
		// fixed zoom level, drag pans while zoomed.
		let desktopZoomed = false;
		let panX = 0;
		let panY = 0;
		let isMouseDown = false;
		let isPanningMouse = false;
		let mouseDownPos = { x: 0, y: 0 };
		let mouseMoveDistance = 0;
		let panPointerStart = { x: 0, y: 0 };
		let panOriginStart = { x: 0, y: 0 };

		function getVisibleTriggers(): HTMLElement[] {
			return Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox]')).filter((el) => {
				const item = el.closest('.drawing-item');
				return !item || !item.classList.contains('is-hidden');
			});
		}

		function resetZoom() {
			const meta = document.querySelector('meta[name="viewport"]');
			if (meta) {
				const original = meta.getAttribute('content') || '';
				meta.setAttribute('content', `${original}, maximum-scale=1`);
				requestAnimationFrame(() => meta.setAttribute('content', original));
			}
			setDesktopZoom(false);
		}

		function applyDesktopZoomTransform() {
			img.style.transform = desktopZoomed ? `translate(${panX}px, ${panY}px) scale(${DESKTOP_ZOOM_SCALE})` : '';
		}

		function clampPan() {
			const frameRect = frame.getBoundingClientRect();
			const maxX = (frameRect.width * (DESKTOP_ZOOM_SCALE - 1)) / 2;
			const maxY = (frameRect.height * (DESKTOP_ZOOM_SCALE - 1)) / 2;
			panX = Math.min(maxX, Math.max(-maxX, panX));
			panY = Math.min(maxY, Math.max(-maxY, panY));
		}

		function setDesktopZoom(value: boolean) {
			desktopZoomed = value;
			panX = 0;
			panY = 0;
			img.classList.toggle('is-zoomed', desktopZoomed);
			applyDesktopZoomTransform();
		}

		// The frame's pixel size is computed directly here, from the trigger's
		// known aspect ratio and the stage's available space — rather than
		// relying on CSS aspect-ratio, which doesn't resolve predictably once a
		// real image with its own intrinsic size loads into it. This runs
		// before any pixel of either the thumbnail or full-res image has
		// loaded, so the box is already the right size and never resizes once
		// a higher-res image swaps in.
		function sizeFrame(ratio: number) {
			if (!Number.isFinite(ratio) || ratio <= 0) return;
			const stageStyle = getComputedStyle(stage);
			const availW = stage.clientWidth - parseFloat(stageStyle.paddingLeft) - parseFloat(stageStyle.paddingRight);
			const availH = stage.clientHeight - parseFloat(stageStyle.paddingTop) - parseFloat(stageStyle.paddingBottom);
			let w = availW;
			let h = w / ratio;
			if (h > availH) {
				h = availH;
				w = h * ratio;
			}
			frame.style.width = `${Math.max(w, 0)}px`;
			frame.style.height = `${Math.max(h, 0)}px`;
		}

		// Warms the full-res asset for whichever drawing prev/next would land
		// on, so stepping there a moment later doesn't wait on the network.
		function preloadNeighbors(triggers: HTMLElement[]) {
			const len = triggers.length;
			if (len < 2) return;
			[currentIndex - 1, currentIndex + 1].forEach((i) => {
				const trigger = triggers[((i % len) + len) % len];
				const fullSrc = trigger?.dataset.fullSrc;
				if (fullSrc && !preloaded.has(fullSrc)) {
					preloaded.add(fullSrc);
					new Image().src = fullSrc;
				}
			});
		}

		function loadCurrent(triggers: HTMLElement[]) {
			const trigger = triggers[currentIndex];
			if (!trigger) return;

			sizeFrame(parseFloat(trigger.dataset.aspectRatio || ''));

			const thumb = trigger.querySelector('img');
			img.src = thumb?.currentSrc || thumb?.src || trigger.dataset.fullSrc || '';
			img.alt = trigger.dataset.alt || trigger.dataset.caption || '';

			const fullSrc = trigger.dataset.fullSrc;
			if (fullSrc) {
				preloaded.add(fullSrc);
				const preload = new Image();
				preload.onload = () => {
					img.src = fullSrc;
				};
				preload.src = fullSrc;
			}

			captionEl.textContent = trigger.dataset.caption || '';
			const multiple = triggers.length > 1;
			countEl.textContent = multiple ? `${currentIndex + 1} / ${triggers.length}` : '';
			prevBtn.hidden = !multiple;
			nextBtn.hidden = !multiple;

			preloadNeighbors(triggers);
		}

		function resizeFrame() {
			const triggers = getVisibleTriggers();
			const trigger = triggers[currentIndex];
			if (trigger) sizeFrame(parseFloat(trigger.dataset.aspectRatio || ''));
		}

		window.addEventListener('resize', resizeFrame);

		function open(index: number, openedFrom: HTMLElement) {
			const triggers = getVisibleTriggers();
			if (!triggers.length) return;
			currentIndex = ((index % triggers.length) + triggers.length) % triggers.length;
			opener = openedFrom;
			setFrameX(0);
			loadCurrent(triggers);
			lightboxEl.removeAttribute('inert');
			lightboxEl.classList.add('is-open');
			document.body.style.overflow = 'hidden';
			lightboxEl.focus();
			document.addEventListener('keydown', onKeydown);
		}

		function close() {
			lightboxEl.classList.remove('is-open');
			lightboxEl.setAttribute('inert', '');
			document.body.style.overflow = '';
			document.removeEventListener('keydown', onKeydown);
			resetZoom();
			stage.classList.remove('is-dragging');
			stage.style.transform = '';
			stage.style.opacity = '';
			opener?.focus();
		}

		// A directional slide, not a crossfade — the outgoing image travels
		// off in the direction it was swiped/navigated and the new one enters
		// from the opposite side, so the motion actually reads as "this drawing
		// moved that way" rather than an unrelated dissolve. Slides the full
		// stage width rather than the frame's own (often narrower) width, so
		// the exit is always genuinely off-screen regardless of the drawing's
		// aspect ratio.
		function slideDistance() {
			return stage.clientWidth;
		}

		// Tracked directly rather than read back from the DOM (getComputedStyle
		// would force a synchronous layout flush on every call, and parsing a
		// matrix() string back out is its own source of bugs).
		let currentX = 0;

		function setFrameX(px: number) {
			currentX = px;
			frame.style.transform = `translateX(${px}px)`;
		}

		// Runs one leg of the slide as an explicit Web Animations API keyframe
		// animation rather than a CSS transition. A CSS transition animates
		// from whatever the element's rendered state happens to be, which is
		// exactly the problem: going out-and-back-in requires an instantaneous,
		// untransitioned jump between the two legs, and whether the browser
		// has actually painted that jump before the next transition starts
		// isn't guaranteed by a single requestAnimationFrame — if it hasn't,
		// the browser can coalesce both writes and animate straight through
		// from the first leg's start to the second leg's end, skipping the
		// jump, so the "new" image looks like it's still entering from the
		// side it just exited on. A WAAPI animation's keyframes are explicit
		// values, not "wherever the element currently is," so there's nothing
		// for the browser to elide: it plays exactly the two values given.
		function animateFrameX(fromPx: number, toPx: number): Promise<void> {
			return new Promise((resolve) => {
				const anim = frame.animate(
					[{ transform: `translateX(${fromPx}px)` }, { transform: `translateX(${toPx}px)` }],
					{ duration: 320, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)', fill: 'forwards' },
				);
				anim.finished
					.then(() => {
						anim.cancel();
						setFrameX(toPx);
						resolve();
					})
					.catch(() => resolve());
			});
		}

		async function beginSlide(direction: 1 | -1) {
			isAnimating = true;
			resetZoom();
			await animateFrameX(currentX, -direction * slideDistance());

			const triggers = getVisibleTriggers();
			currentIndex = ((currentIndex + direction) % triggers.length + triggers.length) % triggers.length;
			// Resized and re-sourced while parked fully off-screen (still
			// clipped by the stage's overflow:hidden), so swapping to a
			// drawing with a different aspect ratio never visibly "grows".
			loadCurrent(triggers);
			setFrameX(direction * slideDistance());

			await animateFrameX(currentX, 0);
			isAnimating = false;
		}

		function goTo(direction: 1 | -1) {
			const triggers = getVisibleTriggers();
			if (isAnimating || triggers.length <= 1) return;
			beginSlide(direction);
		}

		function onKeydown(e: KeyboardEvent) {
			if (e.key === 'Escape') {
				close();
			} else if (e.key === 'ArrowLeft') {
				goTo(-1);
			} else if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Spacebar') {
				e.preventDefault();
				goTo(1);
			} else if (e.key === 'Tab') {
				// Minimal focus trap across the three controls that are ever focusable.
				const focusable = [prevBtn, nextBtn, ...closeTargets].filter(
					(el) => !el.hidden && el.tabIndex !== -1,
				);
				if (!focusable.length) return;
				const first = focusable[0];
				const last = focusable[focusable.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		}

		document.addEventListener('click', (e) => {
			const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
			if (!trigger) return;
			const triggers = getVisibleTriggers();
			const index = triggers.indexOf(trigger);
			if (index !== -1) open(index, trigger);
		});

		closeTargets.forEach((el) =>
			el.addEventListener('click', (e) => {
				// Closes for a click on the empty stage area or the close button
				// itself (including its icon) — not one that bubbled up from the
				// image, which sits inside the stage but shouldn't dismiss it.
				const target = e.target as HTMLElement;
				if (!target.closest('.lightbox-image')) close();
			}),
		);
		prevBtn.addEventListener('click', () => goTo(-1));
		nextBtn.addEventListener('click', () => goTo(1));

		// Desktop zoom: click toggles a fixed zoom level, drag pans while
		// zoomed. Only the current image is ever wired up (its element
		// identity persists across navigations — only its src changes — so
		// this only needs to run once).
		img.addEventListener('mousedown', (e) => {
			if (e.button !== 0 || isAnimating) return;
			isMouseDown = true;
			mouseDownPos = { x: e.clientX, y: e.clientY };
			mouseMoveDistance = 0;
			if (desktopZoomed) {
				isPanningMouse = true;
				panPointerStart = { x: e.clientX, y: e.clientY };
				panOriginStart = { x: panX, y: panY };
				e.preventDefault();
			}
		});

		window.addEventListener('mousemove', (e) => {
			if (!isMouseDown) return;
			mouseMoveDistance = Math.max(
				mouseMoveDistance,
				Math.hypot(e.clientX - mouseDownPos.x, e.clientY - mouseDownPos.y),
			);
			if (!isPanningMouse) return;
			panX = panOriginStart.x + (e.clientX - panPointerStart.x);
			panY = panOriginStart.y + (e.clientY - panPointerStart.y);
			clampPan();
			applyDesktopZoomTransform();
		});

		window.addEventListener('mouseup', () => {
			isMouseDown = false;
			isPanningMouse = false;
		});

		img.addEventListener('click', () => {
			// A real drag-to-pan shouldn't also toggle zoom off on release.
			if (isAnimating || mouseMoveDistance > 4) return;
			setDesktopZoom(!desktopZoomed);
		});

		// Single-finger swipe navigates/dismisses; two fingers (or an active
		// pinch-zoom) are left alone so the browser's native zoom takes over.
		stage.addEventListener(
			'touchstart',
			(e) => {
				if (isAnimating || e.touches.length !== 1 || (window.visualViewport && window.visualViewport.scale > 1.02)) {
					drag = null;
					return;
				}
				const t = e.touches[0];
				drag = { startX: t.clientX, startY: t.clientY, dx: 0, dy: 0, axis: null };
			},
			{ passive: true },
		);

		stage.addEventListener(
			'touchmove',
			(e) => {
				if (!drag || e.touches.length !== 1) return;
				const t = e.touches[0];
				drag.dx = t.clientX - drag.startX;
				drag.dy = t.clientY - drag.startY;
				if (!drag.axis && (Math.abs(drag.dx) > 8 || Math.abs(drag.dy) > 8)) {
					drag.axis = Math.abs(drag.dx) > Math.abs(drag.dy) ? 'x' : 'y';
					if (drag.axis === 'y') stage.classList.add('is-dragging');
				}
				if (drag.axis === 'x') {
					setFrameX(drag.dx);
				} else if (drag.axis === 'y' && drag.dy > 0) {
					stage.style.transform = `translateY(${drag.dy}px)`;
					stage.style.opacity = String(Math.max(1 - drag.dy / 400, 0.3));
				}
			},
			{ passive: true },
		);

		stage.addEventListener('touchend', () => {
			if (!drag) return;
			const { dx, dy, axis } = drag;
			drag = null;

			if (axis === 'x') {
				if (Math.abs(dx) > SWIPE_THRESHOLD) {
					beginSlide(dx < 0 ? 1 : -1);
				} else {
					// Didn't clear the threshold — spring back to rest rather
					// than committing to a navigation.
					isAnimating = true;
					animateFrameX(currentX, 0).then(() => {
						isAnimating = false;
					});
				}
			} else if (axis === 'y') {
				stage.classList.remove('is-dragging');
				if (dy > DISMISS_THRESHOLD) {
					close();
				} else {
					stage.style.transform = '';
					stage.style.opacity = '';
				}
			}
		});
	}

	document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.25s ease;
	}

	.lightbox.is-open {
		opacity: 1;
		visibility: visible;
	}

	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: black;
		opacity: 0.8;
	}

	.lightbox-btn {
		position: absolute;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: none;
		border: none;
		padding: 0;
		color: rgba(255, 255, 255, 0.85);
		cursor: pointer;
		transition: color 0.15s ease;
	}

	.lightbox-btn:hover,
	.lightbox-btn:focus-visible {
		color: white;
	}

	.lightbox-close {
		top: var(--space-2);
		right: var(--space-2);
	}

	.lightbox-nav {
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox-prev {
		left: var(--space-1);
	}

	.lightbox-next {
		right: var(--space-1);
	}

	@media (min-width: 700px) {
		.lightbox-prev {
			left: var(--space-3);
		}

		.lightbox-next {
			right: var(--space-3);
		}
	}

	.lightbox-stage {
		position: relative;
		z-index: 1;
		flex: 1;
		min-height: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		padding: var(--space-4) var(--space-5);
		touch-action: pinch-zoom;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.lightbox-stage.is-dragging {
		transition: none;
	}

	@media (max-width: 699px) {
		.lightbox-stage {
			padding: var(--space-4) var(--space-2);
		}
	}

	/* A plain div has no intrinsic size, so its explicit pixel size (set in
	   JS from the drawing's known aspect ratio) fully determines this box —
	   unlike the img inside it, its size never changes as a lower- or
	   higher-res image loads into that img. The slide itself runs entirely
	   through the Web Animations API (see animateFrameX in the script), not
	   a CSS transition, so there's no transition-class/timing property here —
	   live touch-drag sets the transform directly with no animation at all,
	   tracking the finger 1:1. */
	.lightbox-frame {
		max-width: 100%;
		max-height: 100%;
	}

	.lightbox-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		cursor: zoom-in;
	}

	.lightbox-image.is-zoomed {
		cursor: zoom-out;
	}

	.lightbox-footer {
		position: relative;
		z-index: 2;
		flex-shrink: 0;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3) var(--space-3);
		color: rgba(255, 255, 255, 0.85);
	}

	.lightbox-caption {
		font-size: var(--step--1);
	}

	.lightbox-count {
		font-size: var(--step--1);
		font-variant-numeric: tabular-nums;
		color: rgba(255, 255, 255, 0.55);
		white-space: nowrap;
	}
</style>
