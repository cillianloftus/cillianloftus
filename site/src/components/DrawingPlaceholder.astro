---
import type { Drawing } from '../lib/types';

interface Props {
	drawing: Drawing;
}

const { drawing } = Astro.props;
const label = [...drawing.projection, ...drawing.medium].join(' · ');
---

<div
	class="drawing-placeholder"
	class:list={{ 'full-width': drawing.fullWidth }}
	role="img"
	aria-label={drawing.alt || drawing.caption}
>
	<p class="tag" aria-hidden="true">{label}</p>
</div>

<style>
	.drawing-placeholder {
		aspect-ratio: 4 / 3;
		display: flex;
		align-items: center;
		justify-content: center;
		background: repeating-linear-gradient(
			45deg,
			var(--color-surface),
			var(--color-surface) 10px,
			var(--color-border) 10px,
			var(--color-border) 11px
		);
		border: 1px solid var(--color-border);
		padding: var(--space-2);
	}

	.drawing-placeholder.full-width {
		aspect-ratio: 21 / 9;
	}

	.tag {
		font-size: var(--step--1);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		background: var(--color-bg);
		padding: 0.3em 0.6em;
		text-align: center;
	}
</style>
