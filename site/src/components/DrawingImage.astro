---
import { urlFor } from '../lib/sanity';
import type { Drawing } from '../lib/types';

interface Props {
	drawing: Drawing;
	sizes: string;
	crop?: boolean;
	maxHeight?: string;
	lightbox?: boolean;
	/** For the one above-the-fold image on a page (a project hero) — skips
	 * lazy-loading and asks the browser to fetch it first, since lazy-loading
	 * an LCP element only delays it for no benefit (it's already on screen
	 * at first paint, there's nothing to wait for scroll-into-view for). */
	priority?: boolean;
}

const { drawing, sizes, crop = false, maxHeight, lightbox = false, priority = false } = Astro.props;

const widths = [480, 800, 1200, 1600, 2000];
const srcset = widths
	.map((width) => `${urlFor(drawing.image).width(width).auto('format').url()} ${width}w`)
	.join(', ');
const src = urlFor(drawing.image).width(1200).auto('format').url();
// Wider than the grid srcset's max on purpose: this is what the lightbox
// opens at full-viewport size, and its 2.2x desktop zoom (Lightbox.astro's
// DESKTOP_ZOOM_SCALE) stacks with the display's own device pixel ratio —
// a 2000px source was visibly softer than the ~5000px source PNGs
// (scripts/pdf_to_png.py) actually support once either of those kicked in.
const fullSrc = urlFor(drawing.image).width(3600).auto('format').url();
const alt = drawing.alt || drawing.caption;

// A height-capped image (the project hero) has to give up the component's
// usual `width: 100%` — otherwise the box keeps the container's full width
// even once its height is clamped, so it stops matching the image's own
// aspect ratio and the leftover space shows through as flat background
// color on either side. Letting width track the aspect ratio instead means
// the box always hugs the image exactly, capped growth in either dimension.
const style = [
	crop ? undefined : `aspect-ratio: ${drawing.image.aspectRatio}`,
	maxHeight ? `max-height: ${maxHeight}` : undefined,
	maxHeight ? 'width: auto; max-width: 100%' : undefined,
]
	.filter(Boolean)
	.join('; ');

const Tag = lightbox ? 'button' : 'div';
---

<Tag
	class="drawing-image"
	class:list={{ cropped: crop }}
	style={style || undefined}
	type={lightbox ? 'button' : undefined}
	data-lightbox={lightbox ? '' : undefined}
	data-full-src={lightbox ? fullSrc : undefined}
	data-caption={lightbox ? drawing.caption : undefined}
	data-alt={lightbox ? alt : undefined}
	data-aspect-ratio={lightbox ? drawing.image.aspectRatio : undefined}
	aria-label={lightbox ? `Open full view: ${drawing.caption}` : undefined}
>
	<img
		src={src}
		srcset={srcset}
		sizes={sizes}
		alt={alt}
		loading={priority ? 'eager' : 'lazy'}
		decoding="async"
		fetchpriority={priority ? 'high' : undefined}
	/>
</Tag>

<style>
	.drawing-image {
		display: block;
		width: 100%;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: 0;
		transition: border-color 0.15s ease;
	}

	button.drawing-image {
		cursor: pointer;
	}

	button.drawing-image:hover,
	button.drawing-image:focus-visible {
		border-color: var(--color-accent);
	}

	.drawing-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 0.25s ease;
	}

	button.drawing-image:hover img,
	button.drawing-image:focus-visible img {
		transform: scale(1.03);
	}

	/* Uniform-crop mode, for representative thumbnails (the portfolio index
	   card) where a consistent grid shape matters more than showing the
	   whole sheet. Everywhere else, the box is sized to the image's own
	   aspect ratio instead, so nothing is cropped. */
	.drawing-image.cropped {
		aspect-ratio: 4 / 3;
	}

	.drawing-image.cropped img {
		object-fit: cover;
	}
</style>
