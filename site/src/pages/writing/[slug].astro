---
import Base from '../../layouts/Base.astro';
import { getWritingEntries, portableTextToHtml, sanityConfigured } from '../../lib/sanity';

const categoryLabels = {
	article: 'Article',
	poetry: 'Poetry',
	dissertation: 'Dissertation',
};

export async function getStaticPaths() {
	const entries = sanityConfigured ? await getWritingEntries() : [];
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const bodyHtml = portableTextToHtml(entry.body);
---

<Base title={`${entry.title} · Cillian Loftus`} description={entry.summary}>
	<article class="writing-entry" data-pagefind-body>
		<header>
			<p class="eyebrow">
				<a href="/writing">Writing</a> &middot; {categoryLabels[entry.category]}
			</p>
			<h1 data-pagefind-meta="title">{entry.title}</h1>
			<p class="entry-date">
				<time datetime={entry.date}>
					{new Date(entry.date).toLocaleDateString('en-IE', { year: 'numeric', month: 'long' })}
				</time>
			</p>
		</header>

		<div class="entry-body" set:html={bodyHtml} />

		{
			entry.pdf && (
				<p class="pdf-link">
					{/* entry.pdf is a cross-origin cdn.sanity.io URL, served
					Content-Disposition: inline by default — the download attribute
					is ignored cross-origin, so without ?dl this would just open the
					PDF instead of downloading it (same fix as cv.astro's cvHref). */}
					<a href={`${entry.pdf}?dl`} download>
						Download PDF
					</a>
				</p>
			)
		}
	</article>
</Base>

<style>
	.writing-entry {
		max-width: 40rem;
		padding-block: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.eyebrow {
		font-size: var(--step--1);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
	}

	.eyebrow a {
		color: inherit;
		text-decoration: none;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		color: var(--color-accent);
	}

	h1 {
		font-size: var(--step-4);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin-bottom: var(--space-2);
	}

	.entry-date {
		font-size: var(--step--1);
		color: var(--color-text-muted);
	}

	.entry-body {
		font-size: var(--step-1);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	/* Sanity's block editor allows H2/H3, blockquotes, bold/italic and lists
	   by default (the Studio schema just declares `{ type: 'block' }` with
	   no restrictions) even though nothing had styled them here before —
	   they'd have rendered in raw browser UA defaults, clashing with the
	   rest of the site, the moment an entry actually used one. These target
	   :global() because the HTML comes in via set:html — Astro's scoped
	   data-astro-cid attribute only ever reaches elements present in this
	   component's own template, never content injected at runtime (same
	   reasoning as Search.astro's result styling). The outer flex gap above
	   already gives every top-level block (p, h2, blockquote, ul...) equal
	   spacing; a heading's own margin-top stacks on top of that rather than
	   being collapsed by it, since flexbox never collapses child margins —
	   which is what gives a heading more room above it than below, without
	   having to restructure the layout to get asymmetric spacing. */
	.entry-body :global(h2) {
		margin-top: var(--space-2);
		font-size: var(--step-2);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.entry-body :global(h3) {
		margin-top: var(--space-1);
		font-size: var(--step-0);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.entry-body :global(blockquote) {
		padding-left: var(--space-3);
		border-left: 2px solid var(--color-accent);
		font-style: italic;
		color: var(--color-text-muted);
	}

	.entry-body :global(strong) {
		font-weight: 600;
	}

	.entry-body :global(ul),
	.entry-body :global(ol) {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
		padding-left: 1.3em;
	}

	.entry-body :global(a) {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.15em;
		transition: color 0.15s ease;
	}

	.entry-body :global(a:hover),
	.entry-body :global(a:focus-visible) {
		color: var(--color-accent);
	}

	/* The user's own stated priority for this page: deliberate line breaks
	   and an enjoyable reading rhythm. text-wrap: pretty asks the browser to
	   avoid leaving a single short orphaned word alone on a paragraph's last
	   line — a no-op in browsers that don't support it yet, not a layout
	   dependency. */
	.entry-body :global(p) {
		text-wrap: pretty;
	}

	.pdf-link a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: 500;
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 0.15em;
		transition: color 0.15s ease;
	}

	.pdf-link a:hover,
	.pdf-link a:focus-visible {
		color: var(--color-accent);
	}
</style>
