---
import Base from '../../layouts/Base.astro';
import DrawingImage from '../../components/DrawingImage.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getWritingEntries, portableTextToHtml, sanityConfigured } from '../../lib/sanity';

const categoryLabels = {
	article: 'Article',
	poetry: 'Poetry',
	dissertation: 'Dissertation',
};

export async function getStaticPaths() {
	const entries = sanityConfigured ? await getWritingEntries() : [];
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const bodyHtml = portableTextToHtml(entry.body);
---

<Base title={`${entry.title} · Cillian Loftus`} description={entry.summary}>
	<article class="writing-entry" data-pagefind-body>
		<header>
			<p class="eyebrow">
				<a href="/writing">Writing</a> &middot; {categoryLabels[entry.category]}
			</p>
			<h1 data-pagefind-meta="title">{entry.title}</h1>
			<p class="entry-date">
				<time datetime={entry.date}>
					{new Date(entry.date).toLocaleDateString('en-IE', { year: 'numeric', month: 'long' })}
				</time>
			</p>
		</header>

		<div class="entry-body" set:html={bodyHtml} />

		{
			entry.references && entry.references.length > 0 && (
				<section class="references" aria-labelledby="references-heading">
					<h2 id="references-heading">References</h2>
					<ul class="reference-grid">
						{entry.references.map((ref) => (
							<li>
								<DrawingImage drawing={ref} sizes="(min-width: 700px) 50vw, 100vw" lightbox />
								<p class="reference-caption">{ref.caption}</p>
								<p class="reference-source">
									Source:{' '}
									<a href={ref.sourceUrl} target="_blank" rel="noopener noreferrer">
										{ref.sourceCredit}
									</a>
								</p>
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			entry.pdf && (
				<p class="pdf-link">
					{/* entry.pdf is a cross-origin cdn.sanity.io URL, served
					Content-Disposition: inline by default, and the download attribute
					is ignored cross-origin, so without ?dl this would just open the
					PDF instead of downloading it (same fix as cv.astro's cvHref). */}
					<a href={`${entry.pdf}?dl`} download>
						Download PDF
					</a>
				</p>
			)
		}
	</article>

	<Lightbox />
</Base>

<style>
	.writing-entry {
		padding-block: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.eyebrow {
		font-size: var(--step--1);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
	}

	.eyebrow a {
		color: inherit;
		text-decoration: none;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		color: var(--color-accent);
	}

	h1 {
		font-size: var(--step-4);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin-bottom: var(--space-2);
	}

	.entry-date {
		font-size: var(--step--1);
		color: var(--color-text-muted);
	}

	.entry-body {
		/* Narrower than the header above it: a wide title reads fine since
		   it's a handful of words, but body prose at the same width would
		   run far past a comfortable line length. */
		max-width: 75%;
		/* --step-0 maxes out at 1.13rem (~18px) and floors at 1rem (16px) on
		   narrow viewports, which lands almost exactly on the 18px that read
		   right once compared directly against the larger lede size this
		   used to have (removed below). Kept as a fluid token rather than a
		   bare 18px literal to stay consistent with the rest of the site's
		   clamp()-based type scale. */
		font-size: var(--step-0);
		/* 1.5 (the sitewide body default, inherited otherwise) reads fine for
		   short UI copy but felt cramped across paragraphs this long and
		   dense: more generous line-height gives each line more room to
		   breathe without changing how much text is actually on the page. */
		line-height: 1.65;
		display: flex;
		flex-direction: column;
		/* var(--space-3) (1.5rem) is the sitewide default for tightly related
		   list-style content (nav rows, stack items), too tight once real
		   paragraphs averaging ~700 characters each were in place; this is
		   long-form reading that wants real pauses between paragraphs, not
		   list rhythm. */
		gap: 2.25rem;
	}

	/* First-line indent, book-style, on every paragraph except the ones
	   that open the piece or a section: the opening paragraph is already
	   clearly a start (nothing precedes it), and a paragraph right after
	   a heading is already clearly a fresh start too, so indenting either
	   would mark a break that isn't there. Every other paragraph gets one,
	   since that's the actual signal the indent is meant to carry. */
	.entry-body :global(p) {
		text-indent: 1.5em;
	}

	.entry-body :global(p:first-child),
	.entry-body :global(h2 + p),
	.entry-body :global(h3 + p) {
		text-indent: 0;
	}

	/* Sanity's block editor allows H2/H3, blockquotes, bold/italic and lists
	   by default (the Studio schema just declares `{ type: 'block' }` with
	   no restrictions) even though nothing had styled them here before:
	   they'd have rendered in raw browser UA defaults, clashing with the
	   rest of the site, the moment an entry actually used one. These target
	   :global() because the HTML comes in via set:html, and Astro's scoped
	   data-astro-cid attribute only ever reaches elements present in this
	   component's own template, never content injected at runtime (same
	   reasoning as Search.astro's result styling). The outer flex gap above
	   already gives every top-level block (p, h2, blockquote, ul...) equal
	   spacing; a heading's own margin-top stacks on top of that rather than
	   being collapsed by it, since flexbox never collapses child margins,
	   which is what gives a heading more room above it than below, without
	   having to restructure the layout to get asymmetric spacing. */
	.entry-body :global(h2) {
		margin-top: var(--space-2);
		font-size: var(--step-2);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.entry-body :global(h3) {
		margin-top: var(--space-1);
		/* Was var(--step-0), which matched the body's old size (now step-1)
		   and gave H3 no visual weight at all now that the body itself runs
		   a step smaller. */
		font-size: var(--step-1);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.entry-body :global(blockquote) {
		padding-left: var(--space-3);
		border-left: 2px solid var(--color-accent);
		font-style: italic;
		color: var(--color-text-muted);
	}

	.entry-body :global(strong) {
		font-weight: 600;
	}

	.entry-body :global(ul),
	.entry-body :global(ol) {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
		padding-left: 1.3em;
	}

	.entry-body :global(a) {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.15em;
		transition: color 0.15s ease;
	}

	.entry-body :global(a:hover),
	.entry-body :global(a:focus-visible) {
		color: var(--color-accent);
	}

	/* The user's own stated priority for this page: deliberate line breaks
	   and an enjoyable reading rhythm. text-wrap: pretty asks the browser to
	   avoid leaving a single short orphaned word alone on a paragraph's last
	   line, a no-op in browsers that don't support it yet, not a layout
	   dependency. */
	.entry-body :global(p) {
		text-wrap: pretty;
	}

	/* A distinct section, not part of the entry-body prose flow at all:
	   these support the piece but aren't the author's own work, so they get
	   their own clearly-labeled, clearly-credited space rather than sitting
	   inline as if they were illustrations. */
	.references {
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-border);
	}

	.references h2 {
		font-size: var(--step--1);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-3);
	}

	.reference-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	@media (min-width: 700px) {
		.reference-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.reference-caption {
		font-size: var(--step--1);
		margin-top: var(--space-2);
	}

	.reference-source {
		font-size: var(--step--1);
		color: var(--color-text-muted);
		margin-top: 0.2em;
	}

	.reference-source a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.15em;
		transition: color 0.15s ease;
	}

	.reference-source a:hover,
	.reference-source a:focus-visible {
		color: var(--color-accent);
	}

	.pdf-link a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: 500;
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 0.15em;
		transition: color 0.15s ease;
	}

	.pdf-link a:hover,
	.pdf-link a:focus-visible {
		color: var(--color-accent);
	}
</style>
