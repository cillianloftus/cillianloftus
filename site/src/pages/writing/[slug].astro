---
import Base from '../../layouts/Base.astro';
import { getWritingEntries, portableTextToHtml, sanityConfigured } from '../../lib/sanity';

const categoryLabels = {
	article: 'Article',
	poetry: 'Poetry',
	dissertation: 'Dissertation',
};

export async function getStaticPaths() {
	const entries = sanityConfigured ? await getWritingEntries() : [];
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const bodyHtml = portableTextToHtml(entry.body);
---

<Base title={`${entry.title} · Cillian Loftus`} description={entry.summary}>
	<article class="writing-entry" data-pagefind-body>
		<header>
			<p class="eyebrow">
				<a href="/writing">Writing</a> &middot; {categoryLabels[entry.category]}
			</p>
			<h1 data-pagefind-meta="title">{entry.title}</h1>
			<p class="entry-date">
				<time datetime={entry.date}>
					{new Date(entry.date).toLocaleDateString('en-IE', { year: 'numeric', month: 'long' })}
				</time>
			</p>
		</header>

		<div class="entry-body" set:html={bodyHtml} />

		{
			entry.pdf && (
				<p class="pdf-link">
					{/* entry.pdf is a cross-origin cdn.sanity.io URL, served
					Content-Disposition: inline by default — the download attribute
					is ignored cross-origin, so without ?dl this would just open the
					PDF instead of downloading it (same fix as cv.astro's cvHref). */}
					<a href={`${entry.pdf}?dl`} download>
						Download PDF
					</a>
				</p>
			)
		}
	</article>
</Base>

<style>
	.writing-entry {
		max-width: 40rem;
		padding-block: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.eyebrow {
		font-size: var(--step--1);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
	}

	.eyebrow a {
		color: inherit;
		text-decoration: none;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		color: var(--color-accent);
	}

	h1 {
		font-size: var(--step-4);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin-bottom: var(--space-2);
	}

	.entry-date {
		font-size: var(--step--1);
		color: var(--color-text-muted);
	}

	.entry-body {
		font-size: var(--step-1);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.pdf-link a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: 500;
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 0.15em;
		transition: color 0.15s ease;
	}

	.pdf-link a:hover,
	.pdf-link a:focus-visible {
		color: var(--color-accent);
	}
</style>
