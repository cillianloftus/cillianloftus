---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, sanityConfigured } from '../../lib/sanity';

const projects = sanityConfigured ? await getProjects() : [];
---

<Base title="Portfolio · Cillian Loftus" description="College work, ranging adaptive reuse of existing buildings across Limerick City to technical studies of existing and proposed structures.">
	<section class="portfolio-page" data-pagefind-body>
		<header>
			<p class="eyebrow">Portfolio</p>
			<h1 data-pagefind-meta="title">College work.</h1>
		</header>

		<ul class="project-grid">
			{
				projects.map((project) => (
					<li>
						<ProjectCard project={project} />
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.portfolio-page {
		padding-block: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.eyebrow {
		font-size: var(--step--1);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
	}

	h1 {
		font-size: var(--step-4);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.05;
	}

	.project-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	@media (min-width: 700px) {
		.project-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
