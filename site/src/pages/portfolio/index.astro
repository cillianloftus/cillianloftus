---
import Base from '../../layouts/Base.astro';
import DrawingImage from '../../components/DrawingImage.astro';
import { getProjects, sanityConfigured } from '../../lib/sanity';
import { projectTypeLabels } from '../../lib/types';

const projects = sanityConfigured ? await getProjects() : [];
---

<Base title="Portfolio · Cillian Loftus" description="Studio work on the adaptive reuse of existing buildings across Limerick City.">
	<section class="portfolio-page">
		<header>
			<p class="eyebrow">Portfolio</p>
			<h1>Studio work.</h1>
		</header>

		<ul class="project-grid">
			{
				projects.map((project) => (
					<li>
						<a class="project-card" href={`/portfolio/${project.slug}`}>
							{project.drawings?.[0] && (
								<div class="project-thumb" transition:name={`project-image-${project.slug}`}>
									<DrawingImage drawing={project.drawings[0]} sizes="(min-width: 700px) 50vw, 100vw" />
								</div>
							)}
							<div class="project-copy">
								<h2>{project.title}</h2>
								<p class="project-meta">
									{projectTypeLabels(project.type)} &middot; {project.date?.slice(0, 4)} &middot; {project.location}
								</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.portfolio-page {
		padding-block: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.eyebrow {
		font-size: var(--step--1);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
	}

	h1 {
		font-size: var(--step-4);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.05;
	}

	.project-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	@media (min-width: 700px) {
		.project-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.project-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		text-decoration: none;
		color: inherit;
	}

	.project-thumb {
		transition: opacity 0.15s ease;
	}

	.project-card:hover .project-thumb,
	.project-card:focus-visible .project-thumb {
		opacity: 0.85;
	}

	.project-copy h2 {
		font-size: var(--step-1);
		font-weight: 600;
		letter-spacing: -0.01em;
		transition: color 0.15s ease;
	}

	.project-card:hover .project-copy h2,
	.project-card:focus-visible .project-copy h2 {
		color: var(--color-accent);
	}

	.project-meta {
		font-size: var(--step--1);
		color: var(--color-text-muted);
		margin-top: 0.3em;
		margin-bottom: 0.5em;
	}

</style>
