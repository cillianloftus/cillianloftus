---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getProjects, sanityConfigured, urlFor } from '../../lib/sanity';
import { projectTypeLabels } from '../../lib/types';
import { jsonLd } from '../../lib/seo';

export async function getStaticPaths() {
	const projects = sanityConfigured ? await getProjects() : [];
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const ogImage = project.drawings?.[0]
	? urlFor(project.drawings[0].image).width(1200).height(630).fit('crop').auto('format').url()
	: undefined;
const typeLabels = projectTypeLabels(project.type);

const projectSchema = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	url: new URL(Astro.url.pathname, Astro.site).toString(),
	creator: { '@type': 'Person', name: 'Cillian Loftus' },
	dateCreated: project.date,
	image: ogImage,
	genre: typeLabels || undefined,
	locationCreated: project.location ? { '@type': 'Place', name: project.location } : undefined,
};
---

<Base title={`${project.title} · Cillian Loftus`} description={typeLabels} ogImage={ogImage}>
	<script type="application/ld+json" set:html={jsonLd(projectSchema)} is:inline />
	<ProjectDetail project={project} eyebrowLabel="Portfolio" eyebrowHref="/portfolio" />
	<Lightbox />
</Base>
