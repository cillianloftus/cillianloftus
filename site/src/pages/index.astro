---
import Base from '../layouts/Base.astro';

const hubLinks = [
	{
		href: '/portfolio',
		title: 'Portfolio',
		description: 'Studio work on the adaptive reuse of existing buildings across Limerick City.',
	},
	{
		href: '/drawings',
		title: 'Drawings',
		description: 'Every plan, section, and sketch from the studio work, filterable.',
	},
	{
		href: '/writing',
		title: 'Writing',
		description: 'Essays and poetry, including an award-winning dissertation on AI infrastructure in Ireland.',
	},
	{
		href: '/cv',
		title: 'CV',
		description: 'Studio history, work experience, and research.',
	},
];
---

<Base
	title="Cillian Loftus"
	description="Portfolio, CV, drawings and writing of Cillian Loftus, an architecture student at the University of Limerick."
>
	<section class="hero">
		<p class="eyebrow">Architecture Student · Web Developer · Researcher</p>
		<h1>A body of work, in progress.</h1>
		<p class="subtitle">
			Drawn to adaptive reuse, the architecture of infrastructure and the
			occasional line of code.
		</p>
	</section>

	<section class="hub">
		<ul class="hub-list">
			{
				hubLinks.map((link, index) => (
					<li>
						<a class="hub-row" href={link.href}>
							<span class="hub-copy">
								<span class="hub-title-row">
									<span class="hub-index">{String(index + 1).padStart(2, '0')}</span>
									<span class="hub-title">{link.title}</span>
								</span>
								<span class="hub-description">{link.description}</span>
							</span>
							<span class="hub-arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.hero {
		padding-block: var(--space-5) 0;
	}

	.eyebrow {
		font-size: var(--step--1);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
	}

	.hero h1 {
		font-size: var(--step-4);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.05;
	}

	.subtitle {
		margin-top: var(--space-3);
		font-size: var(--step-1);
		color: var(--color-text-muted);
	}

	.hub {
		padding-block: var(--space-4) var(--space-5);
	}

	.hub-list {
		list-style: none;
	}

	.hub-list li {
		border-top: 1px solid var(--color-border);
	}

	.hub-list li:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.hub-row {
		display: grid;
		grid-template-columns: 1fr 1.5rem;
		align-items: center;
		gap: var(--space-3);
		padding-block: var(--space-3);
		text-decoration: none;
		color: inherit;
	}

	.hub-copy {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}

	.hub-title-row {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
	}

	.hub-index {
		font-size: var(--step-2);
		font-weight: 300;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.hub-title {
		font-size: var(--step-2);
		font-weight: 600;
		letter-spacing: -0.01em;
		transition: color 0.15s ease;
	}

	.hub-description {
		font-size: var(--step--1);
		color: var(--color-text-muted);
		max-width: 34rem;
	}

	.hub-arrow {
		justify-self: end;
		font-size: var(--step-1);
		color: var(--color-text-muted);
		transition:
			color 0.15s ease,
			transform 0.15s ease;
	}

	.hub-row:hover .hub-title,
	.hub-row:focus-visible .hub-title {
		color: var(--color-accent);
	}

	.hub-row:hover .hub-arrow,
	.hub-row:focus-visible .hub-arrow {
		color: var(--color-accent);
		transform: translateX(0.3em);
	}
</style>
