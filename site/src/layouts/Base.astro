---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const pathname = Astro.url.pathname;

const navLinks = [
	{ href: '/portfolio', label: 'Portfolio' },
	{ href: '/drawings', label: 'Drawings' },
	{ href: '/writing', label: 'Writing' },
	{ href: '/cv', label: 'CV' },
].map((link) => ({
	...link,
	current: pathname === link.href || pathname.startsWith(`${link.href}/`),
}));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title="Cillian Loftus" href="/rss.xml" />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content="summary_large_image" />

		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<a class="site-title" href="/">Cillian Loftus</a>
			<nav aria-label="Primary">
				<ul class="nav-links-desktop">
					{navLinks.map((link) => (
						<li>
							<a href={link.href} aria-current={link.current ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
				<details class="nav-toggle">
					<summary class="nav-toggle-button" aria-label="Menu">
						<svg class="icon-menu" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
							<path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
						</svg>
						<svg class="icon-close" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
							<path d="M4.5 4.5l11 11M15.5 4.5l-11 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
						</svg>
					</summary>
					<ul>
						{navLinks.map((link) => (
							<li>
								<a href={link.href} aria-current={link.current ? 'page' : undefined}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</details>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} Cillian Loftus</p>
			<ul>
				<li><a href="/colophon">Colophon</a></li>
				<li><a href="/rss.xml">RSS</a></li>
			</ul>
		</footer>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: -100%;
		left: var(--space-2);
		z-index: 10;
		padding: var(--space-1) var(--space-2);
		background: var(--color-accent);
		color: var(--color-bg);
	}

	.skip-link:focus {
		top: var(--space-2);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding-inline: max(var(--gutter), calc((100% - var(--content-width)) / 2));
		padding-block: var(--space-2);
		background: color-mix(in srgb, var(--color-bg) 85%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}

	.site-title {
		font-size: var(--step-1);
		font-weight: 600;
		text-decoration: none;
		letter-spacing: 0.01em;
	}

	.nav-links-desktop {
		display: none;
	}

	.nav-toggle {
		position: relative;
	}

	.nav-toggle-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		color: var(--color-text);
		cursor: pointer;
		list-style: none;
	}

	.nav-toggle-button::-webkit-details-marker {
		display: none;
	}

	.nav-toggle .icon-close {
		display: none;
	}

	.nav-toggle[open] .icon-menu {
		display: none;
	}

	.nav-toggle[open] .icon-close {
		display: block;
	}

	.nav-toggle > ul {
		position: absolute;
		top: calc(100% + var(--space-1));
		right: 0;
		z-index: 10;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 12rem;
		margin: 0;
		padding: var(--space-2);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
		list-style: none;
	}

	@media (min-width: 700px) {
		.nav-links-desktop {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			list-style: none;
		}

		.nav-toggle {
			display: none;
		}
	}

	.site-header nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
		color: var(--color-text-muted);
		font-size: var(--step--1);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		transition: color 0.15s ease;
	}

	.site-header nav a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 12px;
		width: 100%;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.2s ease;
	}

	.site-header nav a:hover,
	.site-header nav a:focus-visible {
		color: var(--color-text);
	}

	.site-header nav a:hover::after,
	.site-header nav a:focus-visible::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.site-header nav a[aria-current='page'] {
		color: var(--color-text);
	}

	.site-header nav a[aria-current='page']::after {
		transform: scaleX(1);
		background: var(--color-accent);
	}

	main {
		max-width: var(--content-width);
		margin-inline: auto;
		padding: 0 var(--gutter) var(--space-5);
	}

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		max-width: var(--content-width);
		margin-inline: auto;
		padding: var(--space-3) var(--gutter) var(--space-4);
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: var(--step--1);
	}

	.site-footer ul {
		display: flex;
		gap: var(--space-3);
		list-style: none;
	}

	.site-footer a {
		text-decoration: none;
		color: inherit;
	}

	.site-footer a:hover,
	.site-footer a:focus-visible {
		color: var(--color-text);
	}
</style>
