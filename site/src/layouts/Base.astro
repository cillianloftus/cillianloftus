---
import { ClientRouter } from 'astro:transitions';
import Icon, { type IconName } from '../components/icons/Icon.astro';
import '@fontsource/ibm-plex-sans/300.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const navLinks = [
	{ href: '/portfolio', label: 'Portfolio' },
	{ href: '/drawings', label: 'Drawings' },
	{ href: '/writing', label: 'Writing' },
	{ href: '/cv', label: 'CV' },
].map((link) => ({
	...link,
	current: pathname === link.href || pathname.startsWith(`${link.href}/`),
}));

// PLACEHOLDER URLS — replace with real profiles.
const socialLinks: { name: string; href: string; icon: IconName }[] = [
	{ name: 'LinkedIn', href: 'https://www.linkedin.com/in/cillianloftus', icon: 'linkedin' },
	{ name: 'Email', href: 'mailto:cillianloftus@gmail.com', icon: 'email' },
	{ name: 'GitHub', href: 'https://github.com/cillianloftus', icon: 'github' },
	{ name: 'Instagram', href: 'https://www.instagram.com/cillianloftus', icon: 'instagram' },
	{ name: 'Pinterest', href: 'https://www.pinterest.com/cillian0272', icon: 'pinterest' },
	{
		name: 'Spotify',
		href: 'https://open.spotify.com/user/uis31wmrlnhho1wkvoaqsvl2l?si=d8daa32d1e754a29',
		icon: 'spotify',
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(function () {
				var stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.setAttribute('data-theme', stored);
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title="Cillian Loftus" href="/rss.xml" />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content="summary_large_image" />

		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<a class="site-title" href="/">Cillian Loftus</a>
			<div class="header-end">
				<button type="button" class="theme-toggle" aria-label="Toggle color theme">
					<Icon name="sun" size={20} class="icon-sun" />
					<Icon name="moon" size={20} class="icon-moon" />
				</button>
				{!isHome && (
					<nav aria-label="Primary">
						<ul class="nav-links-desktop">
							{navLinks.map((link) => (
								<li>
									<a href={link.href} aria-current={link.current ? 'page' : undefined}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
						<details class="nav-toggle">
							<summary class="nav-toggle-button" aria-label="Menu">
								<Icon name="menu" size={20} class="icon-menu" />
								<Icon name="close" size={20} class="icon-close" />
							</summary>
							<ul>
								{navLinks.map((link) => (
									<li>
										<a href={link.href} aria-current={link.current ? 'page' : undefined}>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</details>
					</nav>
				)}
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<div class="footer-identity">
					<p class="footer-copyright">&copy; {new Date().getFullYear()} Cillian Loftus</p>
					<p class="footer-location">
						<Icon name="location" size={14} />
						Castlebar, Co. Mayo
					</p>
				</div>
				<div class="footer-meta">
				<ul class="social-links">
					{socialLinks.map((social) => (
						<li>
							<a
								href={social.href}
								aria-label={social.name}
								target={social.href.startsWith('mailto:') ? undefined : '_blank'}
								rel={social.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
							>
								<Icon name={social.icon} size={18} />
							</a>
						</li>
					))}
				</ul>
				<ul class="footer-links">
					<li><a href="/colophon">Colophon</a></li>
					<li><a href="/rss.xml">RSS</a></li>
				</ul>
				<p class="footer-credit">Built with Astro &amp; Sanity.</p>
			</div>
			</div>
		</footer>

		<script is:inline>
			function currentTheme() {
				var explicit = document.documentElement.getAttribute('data-theme');
				if (explicit) return explicit;
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}

			function toggleTheme() {
				var next = currentTheme() === 'dark' ? 'light' : 'dark';
				localStorage.setItem('theme', next);
				document.documentElement.setAttribute('data-theme', next);
			}

			function initTheme() {
				var stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.setAttribute('data-theme', stored);
				}
				var button = document.querySelector('.theme-toggle');
				if (button) {
					button.addEventListener('click', toggleTheme);
				}
			}

			initTheme();
			document.addEventListener('astro:after-swap', initTheme);
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: -100%;
		left: var(--space-2);
		z-index: 10;
		padding: var(--space-1) var(--space-2);
		background: var(--color-accent);
		color: var(--color-bg);
	}

	.skip-link:focus {
		top: var(--space-2);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding-inline: max(var(--gutter), calc((100% - var(--content-width)) / 2));
		padding-block: var(--space-2);
		background: color-mix(in srgb, var(--color-bg) 85%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}

	.site-title {
		font-size: var(--step-1);
		font-weight: 600;
		text-decoration: none;
		letter-spacing: 0.01em;
	}

	.header-end {
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}

	.theme-toggle {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: none;
		border: none;
		padding: 0;
		color: var(--color-text);
		cursor: pointer;
	}

	.theme-toggle :global(.icon-sun),
	.theme-toggle :global(.icon-moon) {
		position: absolute;
		top: 50%;
		left: 50%;
		transition:
			opacity 0.4s ease,
			transform 0.4s ease;
	}

	.theme-toggle :global(.icon-sun) {
		opacity: 1;
		transform: translate(-50%, -50%) rotate(0deg) scale(1);
	}

	.theme-toggle :global(.icon-moon) {
		opacity: 0;
		transform: translate(-50%, -50%) rotate(-90deg) scale(0.5);
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .theme-toggle :global(.icon-sun) {
			opacity: 0;
			transform: translate(-50%, -50%) rotate(90deg) scale(0.5);
		}

		:root:not([data-theme='light']) .theme-toggle :global(.icon-moon) {
			opacity: 1;
			transform: translate(-50%, -50%) rotate(0deg) scale(1);
		}
	}

	:root[data-theme='dark'] .theme-toggle :global(.icon-sun) {
		opacity: 0;
		transform: translate(-50%, -50%) rotate(90deg) scale(0.5);
	}

	:root[data-theme='dark'] .theme-toggle :global(.icon-moon) {
		opacity: 1;
		transform: translate(-50%, -50%) rotate(0deg) scale(1);
	}

	:root[data-theme='light'] .theme-toggle :global(.icon-sun) {
		opacity: 1;
		transform: translate(-50%, -50%) rotate(0deg) scale(1);
	}

	:root[data-theme='light'] .theme-toggle :global(.icon-moon) {
		opacity: 0;
		transform: translate(-50%, -50%) rotate(-90deg) scale(0.5);
	}

	.nav-links-desktop {
		display: none;
	}

	.nav-toggle {
		position: relative;
	}

	.nav-toggle-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		color: var(--color-text);
		cursor: pointer;
		list-style: none;
	}

	.nav-toggle-button::-webkit-details-marker {
		display: none;
	}

	.nav-toggle :global(.icon-close) {
		display: none;
	}

	.nav-toggle[open] :global(.icon-menu) {
		display: none;
	}

	.nav-toggle[open] :global(.icon-close) {
		display: block;
	}

	.nav-toggle > ul {
		position: absolute;
		top: calc(100% + var(--space-1));
		right: 0;
		z-index: 10;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 12rem;
		margin: 0;
		padding: var(--space-2);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
		list-style: none;
	}

	@media (min-width: 700px) {
		.nav-links-desktop {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			list-style: none;
		}

		.nav-toggle {
			display: none;
		}
	}

	.site-header nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
		color: var(--color-text-muted);
		font-size: var(--step--1);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		transition: color 0.15s ease;
	}

	.site-header nav a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 12px;
		width: 100%;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.2s ease;
	}

	.site-header nav a:hover,
	.site-header nav a:focus-visible {
		color: var(--color-text);
	}

	.site-header nav a:hover::after,
	.site-header nav a:focus-visible::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.site-header nav a[aria-current='page'] {
		color: var(--color-text);
	}

	.site-header nav a[aria-current='page']::after {
		transform: scaleX(1);
		background: var(--color-accent);
	}

	main {
		flex: 1;
		width: 100%;
		padding-inline: max(var(--gutter), calc((100% - var(--content-width)) / 2));
		padding-block: 0 var(--space-5);
	}

	.site-footer {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding-inline: max(var(--gutter), calc((100% - var(--content-width)) / 2));
		padding-block: var(--space-3) var(--space-4);
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: var(--step--1);
	}

	.footer-top {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-3) var(--space-4);
	}

	.footer-identity {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.footer-location {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}

	.footer-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-2);
	}

	.footer-links {
		display: flex;
		gap: var(--space-3);
		list-style: none;
	}

	.site-footer a {
		text-decoration: none;
		color: inherit;
	}

	.site-footer a:hover,
	.site-footer a:focus-visible {
		color: var(--color-accent);
	}

	.social-links {
		display: flex;
		list-style: none;
		/* icons are 18px inside a 44px touch target; pull the row right
		   so the last icon's ink lines up with the text below, not its
		   invisible hit-box edge */
		margin-right: -13px;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		color: var(--color-text-muted);
		transition: color 0.15s ease;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--color-accent);
	}
</style>
